# ── LLM ───────────────────────────────────────────────────────────────────────
# Fournisseur utilisé pour la reformulation : ollama | openrouter | nvidia
# (mistral | gemini | kimi restent possibles, choisis explicitement — jamais en repli)
# Ollama est local et sans clé ; modèle gemma4:e4b par défaut.
LLM_PROVIDER=ollama
# OLLAMA_URL=http://127.0.0.1:11434/v1   # http://host.docker.internal:11434/v1 depuis Docker
# OLLAMA_MODEL=gemma4:e4b
# OLLAMA_CONTEXTE=20480                  # plafond ; le contexte suit la taille du prompt

# Replis, si Ollama manque : seules ces deux clés servent.
OPENROUTER_API_KEY=    # https://openrouter.ai/keys      (~15 modeles gratuits)
# NVIDIA_API_KEY est défini plus bas (section Synthèse vocale) : une seule clé
# build.nvidia.com couvre le LLM et la voix.

# Facultatives, uniquement pour un --provider explicite :
# MOONSHOT_API_KEY=    # https://platform.moonshot.ai/   (Kimi — PAYANT)
# GEMINI_API_KEY=      # https://aistudio.google.com/apikey  (tier gratuit)
# MISTRAL_API_KEY=     # https://console.mistral.ai/         (tier gratuit)

# Surcharges de modèle facultatives (défauts dans content/providers.py).
# Les défauts sont des alias "latest" : ils ne tombent pas en 404 quand un
# modèle est fermé aux nouveaux comptes, mais peuvent changer sans prévenir.
# Épingle une version ici si tu veux des sorties stables dans le temps.
# KIMI_MODEL=moonshot-v1-32k          # si l'alias kimi-latest n'existe pas
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free   # garder le suffixe :free
# GEMINI_MODEL=gemini-3.6-flash
# MISTRAL_MODEL=mistral-small-latest   # si large n'est pas dans ton tier gratuit
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b   # défaut
# Le catalogue public de build.nvidia.com liste 80+ modèles, mais la plupart
# (Llama, Mixtral...) 404 sur un compte gratuit, vérifié en direct — seuls les
# modèles nvidia/* répondent.

# Repli automatique (OpenRouter puis NVIDIA) quand celui demandé est absent,
# saturé ou surchargé. Actif par défaut : l'écart de qualité sur un
# script est mineur, et le fournisseur ayant répondu est inscrit dans le JSON
# produit (champs llm_provider / llm_replis).
# Mets 0 pour comparer deux fournisseurs sur un même sujet, où une bascule
# fausserait la comparaison.
# LLM_FALLBACK=0

# ── Collecte documentaire outillée (MCP) ──────────────────────────────────────
# Appelée par le graphe de l'étape du script (automation/graphe_script.py) quand
# un sujet libre n'est pas couvert par le corpus, ou à la main par
# `python -m content.agent`. Sans uvx — c'est le cas dans l'image Docker —
# l'agent échoue en repli et le résumé fabriqué reprend.
#
# Serveurs MCP à ouvrir, séparés par des virgules. Vide = tous ceux déclarés dans
# SERVEURS_MCP. Le seul disponible est `fetch`, l'implémentation de référence du
# projet MCP : aucune clé, aucun compte, lancée par uvx.
# AGENT_MCP=fetch

# ── Synthèse vocale ───────────────────────────────────────────────────────────
# qwen3  : local, sans quota, voix `animateur` (media/assets/voix/). Exige
#          Wan2GP installé et un GPU NVIDIA : n'existe pas sous Airflow/Docker.
#          Les termes anglais passent par media/assets/prononciations.json.
# nvidia : repli (magpie-tts-multilingual, NIM hébergé), seul possible sous
#          Airflow. Pas de consigne de jeu — texte + voix + langue.
# gemini : plus utilisé par défaut ni en repli ; possible en --tts-provider
#          explicite, avec GEMINI_API_KEY (GEMINI_TTS_VOICE=Charon).
TTS_PROVIDER=qwen3

# Clé gratuite (aucune carte bancaire) : https://build.nvidia.com/nvidia/magpie-tts-multilingual
NVIDIA_API_KEY=
# NVIDIA_TTS_VOICE=Louise                # seules voix FR dispo : Louise, Pascal

# Qwen3 local : dossier de Wan2GP (avec son .venv), et voix clonée à utiliser.
# WAN2GP_DIR=D:\Wan2GP
# QWEN3_TTS_VOICE=animateur              # une paire .mp3/.txt de media/assets/voix/

# Repli automatique quand le moteur demandé a épuisé son quota.
# **Inactif par défaut**, contrairement au LLM : la voix est un choix éditorial,
# et basculer d'office produirait des vidéos dans une voix non retenue — un
# défaut qui ne s'entend qu'à la lecture.
# TTS_FALLBACK=nvidia   # bascule sur nvidia — seul repli possible sous Airflow
# TTS_FALLBACK=1        # bascule sur qwen3 (utile seulement si gemini est demandé)

# ── Habillage sonore ──────────────────────────────────────────────────────────
# Musique de fond, effacée sous la voix, et bruitage à chaque changement de
# slide : des fichiers de media/assets/sons/ (Stable Audio 3, voir SOURCES.json).
# « aucune » / « aucun » coupe l'un ou l'autre.
# MUSIQUE=tech_minimal              # tech_minimal | lofi_curieux | pulse_energie | aucune
# BRUITAGE_TRANSITION=whoosh        # whoosh | pop | impact | aucun

# ── Base de données ───────────────────────────────────────────────────────────
# Postgres démarré par `astro dev start` (ou `make up`).
# Depuis un conteneur, l'hôte devient `postgres` — géré par docker-compose.override.yml.
# Port 55432 : fixé par docker-compose.override.yml, car Astro en attribue un
# aléatoire à chaque démarrage. Ne pas mettre 5432, refusé par Docker ici.
CONTENU_DB_URL=postgresql://postgres:postgres@127.0.0.1:55432/contenu

# ── Illustrations ─────────────────────────────────────────────────────────────
# wan2gp     : images generees en local (Z-Image Turbo), 9:16 natif, sans quota ;
#              exige WAN2GP_DIR et un GPU. Sous Docker : dégradé nu.
# pexels / cloudflare : API tierces, plus utilisées par défaut ni en repli.
IMAGE_PROVIDER=wan2gp
# IMAGE_FALLBACK=1                       # rouvre le repli sur Pexels
# PEXELS_API_KEY=                        # https://www.pexels.com/api/  (gratuit)
# Jeton « Workers AI — Read » et « Edit » (dash.cloudflare.com), avec l'identifiant
# de compte de la section Workers AI — le jeton seul ne suffit pas.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# ── Publication ───────────────────────────────────────────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=   # généré par : python -m publish.tiktok_auth
META_ACCESS_TOKEN=
META_PAGE_ID=
INSTAGRAM_ACCOUNT_ID=

# ── Recherche sémantique ──────────────────────────────────────────────────────
# fastembed : modèle local via ONNX, aucun quota, fonctionne hors ligne.
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
# FASTEMBED_CACHE=                # défaut : ~/.cache/fastembed (240 Mo)

# ── Export vers le telephone ──────────────────────────────────────────────────
# Dossier miroite par le client Google Drive (PAS le lecteur virtuel en mode
# streaming, que Docker ne sait pas monter). Les videos approuvees y sont
# copiees par `make export-drive`, et deviennent disponibles dans l'app mobile.
DRIVE_EXPORT_DIR=
