# ── LLM ───────────────────────────────────────────────────────────────────────
# Fournisseur utilisé pour la reformulation : gemini | mistral | openrouter | nvidia | kimi
LLM_PROVIDER=mistral

# Renseigne uniquement la clé du fournisseur choisi.
MOONSHOT_API_KEY=      # https://platform.moonshot.ai/   (Kimi — PAYANT)
OPENROUTER_API_KEY=    # https://openrouter.ai/keys      (~15 modeles gratuits)
GEMINI_API_KEY=        # https://aistudio.google.com/apikey  (tier gratuit)
MISTRAL_API_KEY=       # https://console.mistral.ai/         (tier gratuit)
# NVIDIA_API_KEY est déjà défini plus bas (section Synthèse vocale) si tu utilises
# aussi le moteur TTS nvidia : une seule clé build.nvidia.com couvre les deux.

# Surcharges de modèle facultatives (défauts dans content/providers.py).
# Les défauts sont des alias "latest" : ils ne tombent pas en 404 quand un
# modèle est fermé aux nouveaux comptes, mais peuvent changer sans prévenir.
# Épingle une version ici si tu veux des sorties stables dans le temps.
# KIMI_MODEL=moonshot-v1-32k          # si l'alias kimi-latest n'existe pas
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free   # garder le suffixe :free
# GEMINI_MODEL=gemini-3.6-flash
# MISTRAL_MODEL=mistral-small-latest   # si large n'est pas dans ton tier gratuit
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b   # défaut
# Le catalogue public de build.nvidia.com liste 80+ modèles, mais la plupart
# (Llama, Mixtral...) 404 sur un compte gratuit, vérifié en direct — seuls les
# modèles nvidia/* répondent.

# Repli automatique sur un autre fournisseur quand celui demandé est saturé
# (quota journalier) ou surchargé. Actif par défaut : l'écart de qualité sur un
# script est mineur, et le fournisseur ayant répondu est inscrit dans le JSON
# produit (champs llm_provider / llm_replis).
# Mets 0 pour comparer deux fournisseurs sur un même sujet, où une bascule
# fausserait la comparaison.
# LLM_FALLBACK=0

# ── Collecte documentaire outillée (MCP) ──────────────────────────────────────
# Sert au seul `python -m content.agent`, jamais au pipeline : rien n'est branché
# dans run_pipeline. En sujet libre, le résumé envoyé au LLM est fabriqué et le
# modèle écrit de mémoire ; l'agent va lire de vraies pages à la place.
#
# Serveurs MCP à ouvrir, séparés par des virgules. Vide = tous ceux déclarés dans
# SERVEURS_MCP. Le seul disponible est `fetch`, l'implémentation de référence du
# projet MCP : aucune clé, aucun compte, lancée par uvx.
# AGENT_MCP=fetch

# ── Synthèse vocale ───────────────────────────────────────────────────────────
# gemini : voix nettement plus naturelle et dirigeable, débit plus lent.
#          Réutilise GEMINI_API_KEY ci-dessus, aucune clé supplémentaire.
# nvidia : alternative gratuite (magpie-tts-multilingual, NIM hébergé) quand le
#          quota Gemini du jour est épuisé. Pas de consigne de jeu possible —
#          TTS paramétrique classique, texte + voix + langue.
# edge    : repli gratuit et hors ligne, 5 voix françaises.
TTS_PROVIDER=gemini
GEMINI_TTS_VOICE=Charon                  # ~30 voix préréglées disponibles
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview

# Clé gratuite (aucune carte bancaire) : https://build.nvidia.com/nvidia/magpie-tts-multilingual
NVIDIA_API_KEY=
# NVIDIA_TTS_VOICE=Louise                # seules voix FR dispo : Louise, Pascal

# Repli automatique quand le quota Gemini du jour est épuisé (10 appels).
# **Inactif par défaut**, contrairement au LLM : la voix est un choix éditorial,
# et basculer d'office produirait des vidéos dans une voix non retenue — un
# défaut qui ne s'entend qu'à la lecture. À activer pendant le travail sur le
# rendu visuel, où la voix importe peu.
# TTS_FALLBACK=1        # bascule sur edge-tts (gratuit, hors ligne)
# TTS_FALLBACK=nvidia   # bascule sur nvidia à la place (nécessite NVIDIA_API_KEY)

# ── Base de données ───────────────────────────────────────────────────────────
# Postgres démarré par `astro dev start` (ou `make up`).
# Depuis un conteneur, l'hôte devient `postgres` — géré par docker-compose.override.yml.
# Port 55432 : fixé par docker-compose.override.yml, car Astro en attribue un
# aléatoire à chaque démarrage. Ne pas mettre 5432, refusé par Docker ici.
CONTENU_DB_URL=postgresql://postgres:postgres@127.0.0.1:55432/contenu

# ── Illustrations ─────────────────────────────────────────────────────────────
# pexels     : photographies libres de droits, justes mais generiques
# cloudflare : images generees (FLUX.1 schnell), ~150/jour sur le palier gratuit
IMAGE_PROVIDER=pexels
PEXELS_API_KEY=

# Jeton avec les droits « Workers AI — Read » et « Edit », cree sur
# dash.cloudflare.com. L'identifiant de compte s'affiche dans la section
# Workers AI du tableau de bord — le jeton seul ne suffit pas.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell        # https://www.pexels.com/api/  (gratuit)

# ── Publication ───────────────────────────────────────────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=   # généré par : python -m publish.tiktok_auth
META_ACCESS_TOKEN=
META_PAGE_ID=
INSTAGRAM_ACCOUNT_ID=

# ── Recherche sémantique ──────────────────────────────────────────────────────
# fastembed : modèle local via ONNX, aucun quota, fonctionne hors ligne.
#             mistral et gemini réutilisent les clés ci-dessus, au prix d'un quota.
EMBEDDING_PROVIDER=fastembed
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
# FASTEMBED_CACHE=                # défaut : ~/.cache/fastembed (240 Mo)

# ── Export vers le telephone ──────────────────────────────────────────────────
# Dossier miroite par le client Google Drive (PAS le lecteur virtuel en mode
# streaming, que Docker ne sait pas monter). Les videos approuvees y sont
# copiees par `make export-drive`, et deviennent disponibles dans l'app mobile.
DRIVE_EXPORT_DIR=
